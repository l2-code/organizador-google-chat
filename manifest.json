{
  "manifest_version": 3,
  "name": "Organizador da barra lateral do Google Chat",
  "version": "1.0.1",
  "description": "Agrupa os espaços do Google Chat em seções por prefixo do nome, em um clique. Configurável por regras (JSON importável/exportável).",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://chat.google.com/*",
    "https://mail.google.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Organizar barra lateral do Google Chat",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.google.com/*",
        "https://mail.google.com/chat/*"
      ],
      "js": ["src/config.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
