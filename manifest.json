{
  "manifest_version": 3,
  "name": "Organizador da barra lateral do Google Chat",
  "version": "1.0.6",
  "description": "Agrupa os espaços do Google Chat em seções por prefixo do nome, em um clique. Configurável por regras (JSON importável/exportável).",
  "key": "",
  "update_url": "https://raw.githubusercontent.com/l2-code/organizador-google-chat/main/updates.xml",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://chat.google.com/*",
    "https://mail.google.com/chat/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Organizar barra lateral do Google Chat",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.google.com/*",
        "https://mail.google.com/chat/*"
      ],
      "js": [
        "src/config.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
